DATABASE_URL=jdbc:postgresql://localhost:5432/pingche
DATABASE_USERNAME=pingche
DATABASE_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=codex-quota-guard
WEB_SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:8000
AUTH_RATE_LIMIT_PER_MINUTE=20
SPRING_PROFILES_ACTIVE=prod
# Optional first-administrator bootstrap. Configure both values together.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
# ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator
