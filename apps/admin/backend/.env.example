DATABASE_URL=jdbc:postgresql://localhost:5432/pingche
DATABASE_USERNAME=pingche
DATABASE_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=codex-quota-guard
WEB_SERVER_PORT=8080
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:8000
AUTH_RATE_LIMIT_PER_MINUTE=20
SPRING_PROFILES_ACTIVE=prod
# Required for new Codex credentials: an independent secret with at least 32 random bytes.
# Keep this stable and backed up outside the database. Do not reuse JWT_SECRET.
# Existing records encrypted with the old JWT fallback need a planned re-encryption before changing keys.
CODEX_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
# Official Codex CLI executable (not CLIProxyAPI). Windows: use the absolute codex.exe path.
CODEX_LOGIN_COMMAND=codex
# Private temporary parent on the SERVER, never a client/user-accessible or web-served directory.
# CODEX_AUTH_WORK_DIR=D:/BuildCache/pingche/private
# Optional first-administrator bootstrap. Configure both values together.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
# ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator
