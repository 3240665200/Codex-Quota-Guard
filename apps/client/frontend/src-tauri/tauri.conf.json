{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota Guard",
  "version": "0.3.0",
  "identifier": "com.codexquotaguard.desktop",
  "build": {
    "beforeDevCommand": "pnpm build:backend && pnpm dev:renderer",
    "beforeBuildCommand": "pnpm build:desktop",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Quota Guard",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/backend/codex-quota-guard-backend.jar": "backend/codex-quota-guard-backend.jar",
      "resources/java/": "java/",
      "resources/meter/*": "meter/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
