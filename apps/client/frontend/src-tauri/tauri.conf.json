{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota Guard",
  "version": "0.4.14",
  "identifier": "com.codexquotaguard.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:renderer",
    "beforeBuildCommand": "pnpm build:desktop",
    "beforeBundleCommand": "node verify-desktop-package.mjs",
    "features": [
      "custom-protocol"
    ],
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "focus": false,
        "title": "Codex Quota Guard",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http: https:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "publisher": "codexquotaguard",
    "targets": "all",
    "resources": {
      "resources/meter/quota-guard-meter.exe": "meter/quota-guard-meter.exe",
      "resources/meter/install-meter-service.ps1": "meter/install-meter-service.ps1",
      "resources/meter/uninstall-meter-service.ps1": "meter/uninstall-meter-service.ps1",
      "resources/meter/installer-meter.ps1": "meter/installer-meter.ps1",
      "resources/meter/configure-meter-server.ps1": "meter/configure-meter-server.ps1",
      "resources/meter/repair-meter-service.ps1": "meter/repair-meter-service.ps1",
      "resources/meter/configure-cli-adapter.ps1": "meter/configure-cli-adapter.ps1",
      "resources/meter/codex-sdk-adapter.mjs.template": "meter/codex-sdk-adapter.mjs.template",
      "resources/meter/show-meter-logs.ps1": "meter/show-meter-logs.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "./windows/installer-template.nsi",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese"
        ]
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCNzFGMzA3QzFFRkIxQjEKUldTeHNlL0JCL054RzJ3VU1DaVhCbThqMnRLdkhWTjlIUk16UFlXTzc4RGppNTVVaVBiTHg3Um0K",
      "endpoints": [],
      "requireSignedVersion": true,
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
