# Reference only. Run: bash deploy/docker/deploy.sh init http://SERVER_IP:8080 admin@example.com
# init creates .env with independently generated secrets and a password you enter.
# NEVER commit .env or regenerate its keys when upgrading / restoring a database.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
PUBLIC_ORIGIN=http://SERVER_IP:8080
POSTGRES_PASSWORD=
DATABASE_PASSWORD=
JWT_SECRET=
JWT_ISSUER=codex-quota-guard
MAIL_ASSISTANCE_ENCRYPTION_KEY=
# Separate 32-byte Base64 keys. Preserve them with the database backups.
# Missing keys disable the corresponding features; official connections need their key.
# Base Compose accepts HTTP and HTTPS. HTTP does not encrypt passwords or credentials.
OFFICIAL_SESSION_ENCRYPTION_KEY=
# Both Compose variants pass OFFICIAL_AUTHORIZATION_PRESET_FILE as the fixed
# container path /run/secrets/official-authorization.json. Keep its JSON content
# in ./secrets/official-authorization.json, never in this file or an image.
# Optional: absence means preset unavailable; authorization-file import remains usable.
# Limit: 64 KiB; fields: requestedAccountId, authorization, cookie (optional).
# Container UID 10001 needs directory traversal and file read permission.
MANAGED_PROXY_ENCRYPTION_KEY=
MANAGED_PROXY_MAX_PROCESSES=4
MANAGED_PROXY_ALLOW_PRIVATE_NODES=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
