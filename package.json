{
  "name": "codex-quota-guard-monorepo",
  "version": "0.3.15",
  "private": true,
  "description": "Codex Quota Guard client and administration monorepo",
  "packageManager": "pnpm@10.12.3",
  "pnpm": {
    "overrides": {
      "@ant-design/pro-layout>path-to-regexp": "^8.4.0",
      "@umijs/plugins>@ant-design/pro-components": "3.1.14-7",
      "@umijs/plugins>axios": "^1.19.0",
      "@umijs/preset-umi>path-to-regexp": "^1.9.0",
      "dva-immer>immer": "^9.0.6",
      "isomorphic-fetch>node-fetch": "^2.7.0"
    }
  },
  "scripts": {
    "dev:client": "pnpm --dir apps/client/frontend dev",
    "build:client": "pnpm --dir apps/client/frontend build",
    "test:client": "pnpm --dir apps/client/frontend test:unit",
    "dev:admin": "pnpm --dir apps/admin/frontend start",
    "build:admin": "pnpm --dir apps/admin/frontend build",
    "test:admin": "pnpm --dir apps/admin/frontend test",
    "dev:admin-backend": "mvn -f apps/admin/backend/pom.xml spring-boot:run",
    "test:java": "mvn test",
    "verify": "mvn verify && pnpm test:client && pnpm test:admin && pnpm build:client && pnpm build:admin"
  }
}
